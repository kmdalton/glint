data_manager {
  miller_array {
    file = "@MTZ@"
    labels {
      name = "F(+),SIGF(+),F(-),SIGF(-),merged"
      array_type = amplitude
    }
    user_selected_labels = "F(+),SIGF(+),F(-),SIGF(-),merged"
  }
  miller_array {
    file = "@RFREE@"
    labels {
      name = "R-free-flags"
      array_type = integer
    }
    user_selected_labels = "R-free-flags"
  }
  fmodel {
    xray_data {
      outliers_rejection = True
      french_wilson_scale = False
    }
  }
  default_miller_array = "@MTZ@"
  model {
    file = "@PDB@"
  }
  default_model = "@PDB@"
}
refinement {
  crystal_symmetry {
    unit_cell = @CELL@
    space_group = @SG@
  }
  refine {
    strategy = individual_sites *rigid_body *individual_adp
  }
  main {
    number_of_macro_cycles = 5
    wavelength = @WAVELENGTH@
  }
  modify_start_model {
    modify {
      adp {
        atom_selection = """All"""
        set_b_iso = 20.0
      }
    }
  }
  electron_density_maps {
    map_coefficients {
      map_type = 2mFo-DFc
      mtz_label_amplitudes = 2FOFCWT
      mtz_label_phases = PH2FOFCWT
      fill_missing_f_obs = True
    }
    map_coefficients {
      map_type = mFo-DFc
      mtz_label_amplitudes = FOFCWT
      mtz_label_phases = PHFOFCWT
    }
    map_coefficients {
      map_type = anomalous
      mtz_label_amplitudes = ANOM
      mtz_label_phases = PHANOM
    }
  }
}
output {
  prefix = "@PREFIX@"
  serial = 1
  overwrite = True
}
